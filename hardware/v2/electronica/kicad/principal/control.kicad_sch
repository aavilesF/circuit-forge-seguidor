	(text "A1: módulo WeAct STM32G474CEU6 Core Board en zócalos. El módulo toma 3.3 V de esta placa (pines 3V3); su VCC queda libre."
		(exclude_from_sim no)
		(at 25.4 380 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "027feb77-8f4d-50df-b9db-303755b4faed")
	)
	(text "El USB-C, BOOT0 y RESET del módulo quedan accesibles en el borde trasero. Cargador DFU por USB (AN2606: HSI48 + CRS, PA11/PA12)."
		(exclude_from_sim no)
		(at 25.4 384 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "4b5149df-a925-57e6-8889-c96de541ad17")
	)
	(text "PB11 (/CS de la flash QSPI del módulo) sin conectar: la flash queda deseleccionada y PB0, PB1, PB10 se usan para los LED."
		(exclude_from_sim no)
		(at 25.4 388 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "6a908377-ece8-508f-bbca-469b45db4108")
	)
	(text "PB8 = BOOT0 al reset: la compuerta de Q3 tiene 100k a GND, así el zumbador no cambia el arranque."
		(exclude_from_sim no)
		(at 25.4 392 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "f1197e5e-e2ac-5229-b50e-cf265ba8d53c")
	)
	(text "I2C3 (PA8/PC11): ISM330DHCX 0x6A, LPS22DF ambiente 0x5C, LPS22DF de la cámara 0x5D."
		(exclude_from_sim no)
		(at 25.4 396 0)
